<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurseAccountinng.Mobile.Presentation.Pages.Authorized.Widgets.TomorrowAmountWidget">
    <Border
        StrokeThickness="0"
        StrokeShape="RoundRectangle 20"
        BackgroundColor="{StaticResource WorkBackground}"
        HeightRequest="38"
        HorizontalOptions="Fill">

        <Border.Shadow>
            <Shadow Brush="#40000000" Offset="0,2" Radius="30" />
        </Border.Shadow>

        <Label
            x:Name="TextLabel"
            FontFamily="OpenSansRegular"
            FontSize="{StaticResource FontSizeRegular}"
            TextColor="{StaticResource Gray3}"
            HorizontalTextAlignment="Start"
            VerticalOptions="Center"
            Margin="15,0,0,0"/>
        
    </Border>
</ContentView>
