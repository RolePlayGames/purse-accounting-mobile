<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:categories="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Categories"
             xmlns:transactions="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Transactions"
             x:Class="PurseAccountinng.Mobile.Presentation.Pages.Authorized.Transactions.TransactionsTab">
    <VerticalStackLayout VerticalOptions="FillAndExpand">
        <Border
            BackgroundColor="White"
            HorizontalOptions="Fill"
            VerticalOptions="Start">
            <Border.Shadow>
                <Shadow
                    Brush="#40000000"
                    Offset="0,4"
                    Radius="4"
                    Opacity="0.25" />
            </Border.Shadow>
            <categories:MultiCategorySelector
                Margin="0,10,0,10"
                HeaderText="Категория"
                ItemsSource="{Binding Categories}"
                SelectedItemIds="{Binding SelectedCategoryIds}" />
        </Border>
        
        <CollectionView 
            ItemsSource="{Binding DisplayedGroups}"
            VerticalOptions="FillAndExpand"
            RemainingItemsThreshold="5"
            RemainingItemsThresholdReached="OnLoadMoreRequested"
            Margin="0,0,0,60">
            <CollectionView.Resources>
                <Style x:Key="SpacerBoxStyle" TargetType="BoxView">
                    <Setter Property="HeightRequest" Value="20" />
                    <Setter Property="BackgroundColor" Value="LightBlue" />
                </Style>
            </CollectionView.Resources>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <ContentView Margin="0,0,0,15">
                        <transactions:TransactionGroup 
                            Group="{Binding .}"
                            Categories="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.Categories}" />
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Header>
                <BoxView Style="{StaticResource SpacerBoxStyle}" />
            </CollectionView.Header>
            <CollectionView.Footer>
                <BoxView Style="{StaticResource SpacerBoxStyle}" />
            </CollectionView.Footer>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
