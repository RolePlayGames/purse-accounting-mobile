<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:categories="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Categories"
             xmlns:transactions="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Transactions"
             x:Class="PurseAccountinng.Mobile.Presentation.Pages.Authorized.Transactions.TransactionsTab">
    <ContentView.Resources>
        <ResourceDictionary>
            <Style x:Key="Divider" TargetType="BoxView">
                <Setter Property="Color" Value="{StaticResource InactiveElementFill}" />
                <Setter Property="HeightRequest" Value="1" />
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Border
            BackgroundColor="White"
            StrokeThickness="0"
            HorizontalOptions="Fill"
            VerticalOptions="Start"
            Grid.Row="0">
            
            <Border.Shadow>
                <Shadow
                    Brush="#40000000"
                    Offset="0,4"
                    Radius="4"
                    Opacity="0.25" />
            </Border.Shadow>
            
            <categories:MultiCategorySelector
                Margin="0,10,0,10"
                HeaderText="Категория"
                ItemsSource="{Binding Categories}"
                SelectedItemIds="{Binding SelectedCategoryIds}" />

        </Border>
        
        <BoxView Grid.Row="1" Style="{StaticResource Divider}" />

        <CollectionView 
            Grid.Row="2"
            ItemsSource="{Binding DisplayedGroups}"
            RemainingItemsThreshold="2"
            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
            
            <CollectionView.Resources>
                <Style x:Key="SpacerBoxStyle" TargetType="BoxView">
                    <Setter Property="HeightRequest" Value="12.5" />
                    <Setter Property="BackgroundColor" Value="{StaticResource LightBlue}" />
                </Style>
            </CollectionView.Resources>
            
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <BoxView Style="{StaticResource SpacerBoxStyle}" />
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <transactions:TransactionGroup 
                        ViewModel="{Binding .}"
                        Categories="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.CategoriesById}"
                        Margin="0,7.5,0,7.5"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <CollectionView.Footer>
                <BoxView Style="{StaticResource SpacerBoxStyle}" />
            </CollectionView.Footer>
            
        </CollectionView>
    </Grid>
</ContentView>
