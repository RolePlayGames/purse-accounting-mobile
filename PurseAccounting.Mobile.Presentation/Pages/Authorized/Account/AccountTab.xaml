<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:widgets="clr-namespace:PurseAccountinng.Mobile.Presentation.Pages.Authorized.Widgets"
             xmlns:local="clr-namespace:PurseAccountinng.Mobile.Presentation.Pages.Authorized.Account"
             xmlns:plannedTransactions="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.PlannedTransactions"
             xmlns:components="clr-namespace:PurseAccountinng.Mobile.Presentation.Components"
             x:Class="PurseAccountinng.Mobile.Presentation.Pages.Authorized.Account.AccountTab"
             Margin="0,18,0,0">
    <Grid RowDefinitions="Auto,*">
        <widgets:AccountWidget
            x:Name="AccountWidget"
            Grid.Row="0"
            DayAmount="{Binding DayAmount}"
            AvailableAmount="{Binding AvaliableAmount}"
            DaysCount="{Binding DaysCount}"
            Margin="15,0"/>
        
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0,12,0,0">
                <local:AccountAttributesWidget
                    x:Name="AccountAttributesWidget"
                    Grid.Row="0"
                    TotalAmount="{Binding TotalAmount}"
                    PlannedDate="{Binding PlannedDate}"
                    TimeZoneOffset="{Binding TimeZoneOffset}"
                    SaveCommand="{Binding SaveCommand}"
                    IsSaveEnabled="{Binding IsSaveEnabled}"
                    Margin="15,0"/>
                
                <CollectionView 
                    x:Name="AutoPlannedTransactionsList"
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    ItemsSource="{Binding AutoPlannedTransactions}">
                    
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
        
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <plannedTransactions:PlannedTransactionSettingRow 
                                PlannedTransactionSettingInfo="{Binding .}"
                                Categories="{Binding Source={RelativeSource AncestorType={x:Type local:AccountTab}}, Path=BindingContext.Categories}"
                                SwipeCompleted="OnAutoPlannedTransactionSwiped" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    
                </CollectionView>
                
                <components:AddScheduledTransactionButton
                    x:Name="AddScheduledTransactionButton"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Command="{Binding AddScheduledTransactionCommand}"/>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>
