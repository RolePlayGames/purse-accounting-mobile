<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.Categories.CategoryItem"
    WidthRequest="64"
    HeightRequest="70"
    x:Name="RootView">

    <Border
        StrokeThickness="0"
        Background="{Binding IsSelected, Source={x:Reference RootView}, Converter={StaticResource BoolToColorConverter}}"
        StrokeShape="RoundRectangle 10,10,10,10">

        <StackLayout
            HorizontalOptions="Center"
            VerticalOptions="Start"
            Margin="0,3,0,0">

            <Ellipse 
                WidthRequest="50"
                HeightRequest="50"
                Fill="{Binding CircleColor, Source={x:Reference RootView}}" />

            <Label
                Text="{Binding Name, Source={x:Reference RootView}}"
                FontFamily="OpenSansRegular"
                FontSize="{StaticResource FontSizeXSmall}"
                TextColor="{Binding IsSelected, Source={x:Reference RootView}, Converter={StaticResource BoolToCategoryTextColorConverter}}"
                HorizontalOptions="Center"
                MaxLines="1"
                LineBreakMode="TailTruncation"
                WidthRequest="58"
                HorizontalTextAlignment="Center" />

        </StackLayout>

    </Border>
</ContentView>
