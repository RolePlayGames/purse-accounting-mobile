<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.Categories.MultiCategorySelector"
             x:Name="Root">
    
    <StackLayout Spacing="7">
        
        <Label
            Text="{Binding HeaderText, Source={x:Reference Root}}"
            FontFamily="OpenSansSemibold"
            FontSize="{StaticResource FontSizeRegular}"
            TextColor="{StaticResource DarkPurple}"
            HorizontalOptions="Center" />
        
        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <StackLayout
                x:Name="ItemsContainer"
                Orientation="Horizontal"
                Spacing="1"
                Padding="12,0" />
        </ScrollView>
        
    </StackLayout>
    
</ContentView>

