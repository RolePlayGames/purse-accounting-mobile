<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:icons="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Icons"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.IosStyleSwitchWithIcon"
             x:Name="Root">

    <HorizontalStackLayout Spacing="20" VerticalOptions="Center">

        <Border x:Name="SwitchTrack"
                WidthRequest="66"
                HeightRequest="34"
                StrokeThickness="0"
                BackgroundColor="{Binding Source={x:Reference Root}, Path=IsToggled, Converter={StaticResource BoolToSwitchTrackColorConverter}}"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="17" />
            </Border.StrokeShape>

            <Border x:Name="SwitchThumb"
                    WidthRequest="32"
                    HeightRequest="32"
                    BackgroundColor="{StaticResource WorkBackground}"
                    HorizontalOptions="Start"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <icons:AutoPlannedSettingIcon IsActive="{Binding Source={x:Reference Root}, Path=IsToggled}"
                                              WidthRequest="24"
                                              HeightRequest="24"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center" />
            </Border>

        </Border>

        <Label Text="{Binding Source={x:Reference Root}, Path=Description}"
               FontFamily="OpenSansRegular"
               FontSize="{StaticResource FontSizeRegular}"
               TextColor="{StaticResource Gray2}"
               VerticalTextAlignment="Center"
               VerticalOptions="Center" />
    </HorizontalStackLayout>

</ContentView>
