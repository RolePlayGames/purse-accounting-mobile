<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.IosStyleSwitch"
             x:Name="Root">

    <HorizontalStackLayout Spacing="20"
                           VerticalOptions="Center">

        <!-- Switch itself: 66x34, fully rounded (semicircle caps on the left and right) -->
        <Border x:Name="SwitchTrack"
                WidthRequest="66"
                HeightRequest="34"
                StrokeThickness="0"
                BackgroundColor="{Binding Source={x:Reference Root}, Path=IsToggled, Converter={StaticResource BoolToSwitchTrackColorConverter}}"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="17" />
            </Border.StrokeShape>

            <AbsoluteLayout>
                <!-- Thumb: 32x32 circle, right side when toggled, left side otherwise -->
                <BoxView x:Name="SwitchThumb"
                         WidthRequest="32"
                         HeightRequest="32"
                         CornerRadius="16"
                         Color="{StaticResource WorkBackground}"
                         AbsoluteLayout.LayoutBounds="1, 0.5, 32, 32"
                         AbsoluteLayout.LayoutFlags="PositionProportional" />
            </AbsoluteLayout>
        </Border>

        <Label Text="{Binding Source={x:Reference Root}, Path=Description}"
               FontFamily="OpenSansRegular"
               FontSize="{StaticResource FontSizeRegular}"
               TextColor="{StaticResource Gray2}"
               VerticalTextAlignment="Center"
               VerticalOptions="Center" />
    </HorizontalStackLayout>

</ContentView>
