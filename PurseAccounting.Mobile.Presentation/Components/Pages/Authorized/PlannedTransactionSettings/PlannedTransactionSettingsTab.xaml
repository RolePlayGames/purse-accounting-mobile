<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Pages.Authorized.PlannedTransactionSettings"
             xmlns:plannedTransactions="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.PlannedTransactions"
             xmlns:components="clr-namespace:PurseAccountinng.Mobile.Presentation.Components"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.Pages.Authorized.PlannedTransactionSettings.PlannedTransactionSettingsTab"
             Margin="0,18,0,0">
    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,*" Padding="0,12,0,0">
            <local:PlannedTransactionAttributesWidget
                x:Name="PlannedTransactionAttributesWidget"
                Grid.Row="0"
                TransactionName="{Binding TransactionName, Mode=TwoWay}"
                Amount="{Binding Amount, Mode=TwoWay}"
                TransactionChangeType="{Binding TransactionChangeType, Mode=TwoWay}"
                Categories="{Binding Categories}"
                SelectedCategoryId="{Binding SelectedCategoryId, Mode=TwoWay}"
                SaveCommand="{Binding SaveCommand}"
                IsSaveEnabled="{Binding IsSaveEnabled}"
                Margin="15,0,15,12"/>

            <CollectionView
                x:Name="AutoPlannedTransactionsList"
                Grid.Row="1"
                ItemsSource="{Binding AutoPlannedTransactions}">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <plannedTransactions:PlannedTransactionSettingRow
                            PlannedTransactionSettingInfo="{Binding .}"
                            Categories="{Binding Source={RelativeSource AncestorType={x:Type local:PlannedTransactionSettingsTab}}, Path=BindingContext.Categories}"
                            SwipeCompleted="OnAutoPlannedTransactionSwiped" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <components:AddScheduledTransactionButton
                x:Name="AddScheduledTransactionButton"
                Grid.Row="2"
                Margin="0,12,0,0"
                Command="{Binding AddScheduledTransactionCommand}"/>
        </Grid>
    </ScrollView>
</ContentView>
