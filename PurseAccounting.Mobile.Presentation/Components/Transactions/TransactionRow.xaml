<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.Transactions.TransactionRow"
             x:Name="RootView">
    
    <Grid x:Name="MainGrid" ClipToBounds="True">
        <!-- Purple background that appears when swiping -->
        <BoxView 
            x:Name="PurpleBackground"
            BackgroundColor="{StaticResource Purple}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsVisible="False" />
        
        <!-- Main content that slides -->
        <Grid x:Name="ContentGrid" BackgroundColor="{StaticResource LightBlue}">
            <ContentView x:Name="ContentHost" />
        </Grid>
    </Grid>
</ContentView>
