<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.Transactions.TransactionRow"
             x:Name="RootView">

    <Grid x:Name="MainGrid" ColumnDefinitions="30,12,*,*" RowDefinitions="30">
        <!-- Фоновый прямоугольник (Purple) -->
        <BoxView 
            x:Name="BackgroundBox"
            Grid.ColumnSpan="4"
            BackgroundColor="{StaticResource Purple}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />
        
        <!-- Контейнер контента -->
        <Grid 
            x:Name="ContentContainer"
            ColumnDefinitions="30,12,*,*" 
            RowDefinitions="30"
            BackgroundColor="{StaticResource LightBlue}">
            <!-- Круг категории -->
            <Ellipse 
                Grid.Column="0"
                WidthRequest="30"
                HeightRequest="30"
                Fill="{Binding CircleColor, Source={x:Reference RootView}}" />
            
            <!-- Сумма транзакции -->
            <Label 
                Grid.Column="2"
                Text="{Binding AmountText, Source={x:Reference RootView}}"
                FontFamily="OpenSansRegular"
                FontSize="{StaticResource FontSizeLarge}"
                TextColor="{Binding AmountTextColor, Source={x:Reference RootView}}"
                VerticalOptions="Center" />
            
            <!-- Тип транзакции -->
            <Label 
                Grid.Column="3"
                Text="{Binding TransactionTypeText, Source={x:Reference RootView}}"
                FontFamily="OpenSansRegular"
                FontSize="{StaticResource FontSizeRegular}"
                TextColor="{StaticResource Gray3}"
                HorizontalOptions="End"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentView>
