<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:transactions="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Transactions"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.Transactions.TransactionGroup"
             x:Name="RootView">
    <Border 
        StrokeThickness="0"
        BackgroundColor="{StaticResource WorkBackground}"
        StrokeShape="RoundRectangle 20"
        Padding="0,11,0,11"
        Margin="15,0,15,0">
        
        <VerticalStackLayout>

            <VerticalStackLayout Margin="16,0,16,0">                
                <Label 
                    Text="{Binding DateText, Source={x:Reference RootView}}"
                    FontFamily="OpenSansSemibold"
                    FontSize="{StaticResource FontSizeLarge}"
                    TextColor="{StaticResource DarkPurple}"
                    HorizontalOptions="Start"/>
            
                <BoxView 
                    HeightRequest="1"
                    BackgroundColor="{StaticResource InactiveElementFill}"
                    Margin="0,12,0,0" />            
            </VerticalStackLayout>
            
            <VerticalStackLayout
                Margin="0,15,0,0"
                BindableLayout.ItemsSource="{Binding Transactions, Source={x:Reference RootView}}">                
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <transactions:TransactionRow 
                            Transaction="{Binding .}"
                            Categories="{Binding Source={x:Reference RootView}, Path=Categories}"
                            SwipeCompleted="OnTransactionSwipeCompleted" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
