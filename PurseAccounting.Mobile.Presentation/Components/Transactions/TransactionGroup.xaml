<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:transactions="clr-namespace:PurseAccountinng.Mobile.Presentation.Components.Transactions"
             x:Class="PurseAccountinng.Mobile.Presentation.Components.Transactions.TransactionGroup"
             x:Name="RootView">
    
    <VerticalStackLayout x:Name="ItemsStackLayout" 
                         Spacing="0">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <transactions:TransactionRow Content="{Binding}" />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
