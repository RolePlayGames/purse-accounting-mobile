```gitignore
# Build artifacts and binaries
*.exe
*.dll
*.so
*.a
*.obj
*.out
bin/
obj/
Debug/
Release/

# Dependencies
packages/
node_modules/
vendor/
lib/

# IDE files
.vs/
.vscode/
.idea/
*.userprefs
*.suo
*.user
*.aps
*.ncb
*.opendb
*.opensdf

# Logs
*.log
logs/

# Environment
.env
.env.local
.env.*

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
*.cache

# Testing
TestResults/
coverage/
*.coverage

# NuGet
*.nupkg
.nuget/
```